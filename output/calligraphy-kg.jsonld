]
},
{
"@id": "urn:cn-calligraphy-kg:Q11587360",
"@type": "CalligraphyWork",
"name": "石鼓文",
"sameAs": "http://www.wikidata.org/entity/Q11587360",
"url": "https://zh.wikipedia.org/wiki/%E7%9F%B3%E9%BC%93%E6%96%87",
"description": "石鼓文处于承前启后的时期，承秦国书风，为小篆先声。石鼓文刻于十座花岗岩石上，因石墩形似鼓，故称为“石鼓”。石鼓文与金文有较大差别，具有明显的动感，是中国现存最早的刻石文字。",
"workForm": [
"石刻"
]
},
{
"@id": "urn:cn-calligraphy-kg:Q11054679",
"@type": "CalligraphyWork",
"name": "峄山刻石",
"sameAs": "http://www.wikidata.org/entity/Q11054679",
"url": "https://zh.wikipedia.org/wiki/%E5%B6%A7%E5%B1%B1%E5%88%BB%E7%9F%B3",
"description": "峄山刻石高218厘米、宽84厘米 。两面刻文，共15行，满行15字，相传为李斯所书。《峄山刻石》高218厘米、宽84厘米。峄山刻石书体是小篆，也就是仅存不多的小篆刻石，传说是李斯的书法手迹，但于史无据。",
"writtenInScript": [
