{
"@id": "urn:cn-calligraphy-kg:Q468712",
"@type": "Calligrapher",
"name": "嵇康",
"sameAs": "http://www.wikidata.org/entity/Q468712",
"url": "https://zh.wikipedia.org/wiki/%E5%B5%87%E5%BA%B7",
"birthDate": 223,
"deathDate": 262,
"gender": "男",
"birthPlace": "濉溪县",
"description": "嵇（jī）康（223年—263年），字叔夜，谯郡铚（今安徽省濉溪县）人，因曾官至曹魏中散大夫，故后世又称嵇中散。三国曹魏文学家、思想家、音乐家。为魏晋时期文人团体“竹林七贤”之一，与阮籍齐名，并称嵇阮，同为魏末文学界与思想界的代表人物。他激烈抨击世俗规范，主张顺应自然法则，保全人的天性，积极推广服食养生理论，在当时极具有非常高的声望及号召力。后因卷入朋友吕安的诉讼而入狱，权臣司马昭忌惮他的言论影响力会威胁司马氏政权，在锺会的建议下将其处死。",
"alternateName": [
"叔夜"
],
"isLiving": false,
"inDynasty": [
{
"@id": "urn:cn-calligraphy-kg:ef53e2e7d8d82"
}
]
},
