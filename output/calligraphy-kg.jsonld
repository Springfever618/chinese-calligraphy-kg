{
"@id": "urn:cn-calligraphy-kg:Q197162",
"@type": "Person",
"name": "章太炎",
"sameAs": "http://www.wikidata.org/entity/Q197162",
"url": "https://zh.wikipedia.org/wiki/%E7%AB%A0%E5%A4%AA%E7%82%8E",
"birthDate": 1869,
"deathDate": 1936,
"gender": "男",
"birthPlace": "余杭区",
"description": "章太炎（1869年1月12日—1936年6月14日），原名学乘，字枚叔，一作梅叔。后易名为炳麟。因反清意识浓厚，慕顾绛的为人行事而改名为绛，号太炎。世人常称之为“太炎先生”。早年又号膏兰室主人、刘子骏私淑弟子等。浙江余杭人，清末民初思想家、史学家、朴学大师、民族主义革命家、注音符号设计者、中国医学院首任院长，国粹派代表人物。",
"alternateName": [
"太炎",
"枚叔"
],
