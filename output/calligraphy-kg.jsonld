{
"@id": "urn:cn-calligraphy-kg:Q1420392",
"@type": "CalligraphyWork",
"name": "兰亭集序",
"sameAs": "http://www.wikidata.org/entity/Q1420392",
"url": "https://zh.wikipedia.org/wiki/%E8%98%AD%E4%BA%AD%E9%9B%86%E5%BA%8F",
"description": "《兰亭集序》，又称作《兰亭序》、《兰亭叙》、《兰亭帖》、《禊序》、《禊帖》、《临河序》、《兰亭宴集序》，为东晋书法家王羲之所作，有“天下第一行书”之称，是晋代书法成就的代表。《兰亭集序》共计324字，凡是重复的字都各不相同，其中21个“之”字，各具风韵，皆无雷同。王羲之酒醒之后，过几天又把原文重写了好多本，但终究没有在兰亭集会时所写的好。",
"calligrapher": [
{
"@id": "urn:cn-calligraphy-kg:Q378564"
}
],
"writtenInScript": [
{
"@id": "urn:cn-calligraphy-kg:e5e52bdf4e0e5"
}
]
},
{
"@id": "urn:cn-calligraphy-kg:e5e52bdf4e0e5",
"@type": "ScriptStyle",
"name": "行书",
"description": "行书又称连笔书法，是汉字书法中的一种手写字体风格，由楷书快速书写时笔划出现连结发展而来。行书还可细分为两类：行楷与正楷较为接近，字形也清晰易辨，但笔划末端更圆滑且相近的笔划常常连成一笔；行草则介于草书与行楷之间，字体更加豪放，具有一笔带过的动感，但字迹不像草书那样潦草难以辨认。"
},
{
"@id": "urn:cn-calligraphy-kg:Q11591091",
"@type": "CalligraphyWork",
"name": "祭侄文稿",
"sameAs": "http://www.wikidata.org/entity/Q11591091",
"url": "https://zh.wikipedia.org/wiki/%E7%A5%AD%E5%A7%AA%E6%96%87%E7%A8%BF",
"description": "《祭侄文稿》，全名《祭侄赠赞善大夫季明文文稿》，俗谓《祭侄帖》、《祭侄稿》。是唐朝书法家颜真卿于乾元元年九月初三（758年10月9日）所书，后世誉为“在世颜体第一”、“天下行书第二”，真迹现藏于国立故宫博物院。王羲之《兰亭集序》、颜真卿《祭侄文稿》、苏东坡《寒食帖》合称“天下三大行书字帖”。这件作品是颜真卿为了祭侄文而写下的草稿，是在极度悲愤的情绪下书写，由于心情极度悲愤且已难以平静，字随颜真卿情绪起伏使错误之处增多，时有涂抹，也顾不得笔墨的工拙，纯是精神和平时功力的自然流露，是极具史料价值和艺术价值的墨迹原作之一。",
"calligrapher": [
{
"@id": "urn:cn-calligraphy-kg:Q758566"
}
],
"writtenInScript": [
{
"@id": "urn:cn-calligraphy-kg:e5e52bdf4e0e5"
}
],
"heldBy": [
"台北故宫博物院"
]
},
{
"@id": "urn:cn-calligraphy-kg:Q10955092",
"@type": "CalligraphyWork",
"name": "寒食帖",
"sameAs": "http://www.wikidata.org/entity/Q10955092",
"url": "https://zh.wikipedia.org/wiki/%E5%AF%92%E9%A3%9F%E5%B8%96",
"description": "《寒食帖》，全名《黄州寒食诗帖》，简称《寒食诗帖》，又称《寒食节帖》，是北宋苏轼被贬黄州第三年（公元1082年，元丰五年）的行书代表作，左侧有黄庭坚跋文，被誉为“苏书第一”，二十世纪末更被评为“天下第三行书”，现收藏于台北国立故宫博物院，中华邮政曾发行其书法邮票。",
"calligrapher": [
{
"@id": "urn:cn-calligraphy-kg:Q36020"
}
],
"writtenInScript": [
{
"@id": "urn:cn-calligraphy-kg:e5e52bdf4e0e5"
}
],
"heldBy": [
"台北故宫博物院"
]
},
{
"@id": "urn:cn-calligraphy-kg:Q10878855",
"@type": "CalligraphyWork",
"name": "九成宫醴泉铭",
"sameAs": "http://www.wikidata.org/entity/Q10878855",
"url": "https://zh.wikipedia.org/wiki/%E4%B9%9D%E6%88%90%E5%AE%AB%E9%86%B4%E6%B3%89%E9%93%AD",
"description": "《九成宫醴泉铭》是唐代皇帝李世民为纪念九成宫发现泉水，而命令宰相魏徵撰文、书法家欧阳询书写铭文，刻成石碑。此碑为楷书字体，全碑共24行，每行50个字，碑身与碑首相连一体，碑首刻有六条缠绕的螭龙，碑额为篆书，分两行题写“九成宫醴泉铭”六个字。其碑布白疏朗，结体化长为方，点画比较淳厚，用笔稳健含蓄。学习书法者常以临摹此作品练习楷书。",
"calligrapher": [
{
"@id": "urn:cn-calligraphy-kg:Q1207679"
}
],
"writtenInScript": [
{
"@id": "urn:cn-calligraphy-kg:e980068770f67"
}
],
"workForm": [
"碑刻"
]
},
{
"@id": "urn:cn-calligraphy-kg:e980068770f67",
"@type": "ScriptStyle",
"name": "楷书",
"description": "楷书，亦称今隶、真书、正楷、楷体或正书，是汉字书法中最常见的一种字体风格。"
},
{
