{
"@id": "urn:cn-calligraphy-kg:Q15926127",
"@type": "Calligrapher",
"name": "曹卫民",
"sameAs": "http://www.wikidata.org/entity/Q15926127",
"url": "https://zh.wikipedia.org/wiki/%E6%9B%B9%E5%8D%AB%E6%B0%91",
"birthDate": 1968,
"gender": "男",
"birthPlace": "江西省",
"description": "曹卫民（1968年10月—），笔名曹真，中国江西赣州当代书法家，出生于江西寻乌，赣州市书法家协会主席。 曾获得中华人民共和国文化部第十二届群星奖优秀书法奖和其它奖项，及被中国书法家协会评为2010年“书法进万家”活动先进个人。 作品曾入选第五届中国书坛新人作品展、第二届中国书法兰亭奖安美杯书法展、全国首届公务员书法大展等书法展览， 同时曾在深圳博物馆主办《曹卫民书法艺术作品展》，作品收录在《曹卫民书法作品集》。",
"isLiving": true,
"inDynasty": [
{
"@id": "urn:cn-calligraphy-kg:ea348f45c45fa"
}
]
},
{
"@id": "urn:cn-calligraphy-kg:Q17502249",
"@type": "Calligrapher",
"name": "陈奇",
"sameAs": "http://www.wikidata.org/entity/Q17502249",
"url": "https://zh.wikipedia.org/wiki/%E9%99%88%E5%A5%87_%28%E7%94%BB%E5%AE%B6%29",
"birthDate": 1956,
"gender": "男",
"birthPlace": "中华人民共和国",
"description": "陈奇，（1956年—），辽宁沈阳人，字悟石，旅居新加坡华人画家。陈奇的作品以人物画和油画见长。陈奇的作品涉猎了中国水墨和西洋油彩两个不同的领域，并于90年代中期于新加坡开创了双栖绘画运动，因此被人称为双栖画家。陈奇的画风受到了德国表现主义的强烈影响，注意运用颜色语言来表达思想和情感。谢清评价陈奇的作品，“富有童趣，构图丰厚，用色大胆。书法更是一绝”。",
"alternateName": [
"悟石"
],
"isLiving": true,
"inDynasty": [
{
"@id": "urn:cn-calligraphy-kg:ea348f45c45fa"
}
]
},
{
"@id": "urn:cn-calligraphy-kg:Q104782316",
"@type": "Calligrapher",
"name": "陈伯希",
"sameAs": "http://www.wikidata.org/entity/Q104782316",
"url": "https://zh.wikipedia.org/wiki/%E9%99%88%E4%BC%AF%E5%B8%8C",
"birthDate": 1922,
"deathDate": 2016,
