{
"@id": "urn:cn-calligraphy-kg:Q116233969",
"@type": "Calligrapher",
"name": "杜忠诰",
"sameAs": "http://www.wikidata.org/entity/Q116233969",
"url": "https://zh.wikipedia.org/wiki/%E6%9D%9C%E5%BF%A0%E8%AA%A5",
"birthDate": 1948,
"deathDate": 2026,
"gender": "男",
"birthPlace": "埤头乡",
"description": "杜忠诰（1948年11月6日—2026年10月28日），号研农、玄泉老人、算沙老人、涧松老人等，出生于台湾彰化县埤头乡，为台湾书法艺术家，兼擅行、草、隶、篆、楷等各体，并从事儒、释、道思想及汉字形体之研究。杜忠诰毕业于台湾省立台中师范专科学校（语文组）、国立台湾师范大学国文学系。受书画家吕佛庭启蒙学习国画，后转而专攻书法。中年留学日本，获筑波大学艺术学研究所硕士，返台后获国立台湾师范大学文学博士。书法作品曾于台湾、日本、澳洲、美国、韩国、中国大陆等地展出，主要著作有《书道技法123》、《说文篆文讹形释例》、《汉字沿革与文化重建─从情、法、理的角度看两岸简、繁体字》、《池边影事》、《研农闻思录》",
"alternateName": [
"研农"
],
"isLiving": false,
"inDynasty": [
{
"@id": "urn:cn-calligraphy-kg:ee605ad041b82"
}
]
},
